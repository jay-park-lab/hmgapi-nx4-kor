diff -ruN a/os_dep/linux/usb_ops_linux.c b/os_dep/linux/usb_ops_linux.c
--- a/os_dep/linux/usb_ops_linux.c	2026-06-15 16:07:00.000000000 +0000
+++ b/os_dep/linux/usb_ops_linux.c	2026-11-23 05:55:37.008590014 +0000
@@ -744,6 +744,30 @@
 
 int recvbuf2recvframe(PADAPTER padapter, void *ptr);
 
+/* kp-protect: rxloop - 수신 오류 때 곧바로 다시 보내는 것을 1초 200번으로 제한하고, 장치가 CONFIGURED보다 낮으면(떨어짐·리셋 중) 멈춘다(SUSPENDED는 멈추지 않음) */
+static int kp_rx_err_stop(_adapter *padapter, struct urb *purb)
+{
+	static unsigned long kp_win;
+	static int kp_cnt;
+	static int kp_said;
+
+	if (purb->dev == NULL || purb->dev->state < USB_STATE_CONFIGURED)
+		goto stop;
+	if (kp_cnt == 0 || time_after(jiffies, kp_win + HZ)) {
+		kp_win = jiffies;
+		kp_cnt = 0;
+	}
+	if (++kp_cnt <= 200)
+		return 0;
+stop:
+	if (kp_said < 3) {
+		kp_said++;
+		printk(KERN_INFO "kp-protect: rx error loop stopped\n");
+	}
+	rtw_set_drv_stopped(padapter);
+	return 1;
+}
