+++ b/os_dep/linux/usb_ops_linux.c
@@ -743,6 +743,30 @@
 }
 
 int recvbuf2recvframe(PADAPTER padapter, void *ptr);
+
+/* nx4-protect: 수신이 오류로 끝나면 드라이버는 수신 요청을 곧바로 다시 건다(완료 콜백, 인터럽트 문맥). 장치가 망가졌거나 반쯤
+ * 뽑혀 오류와 성공이 섞여 오면, 드라이버의 연속 오류 세기(continual_io_error, 한 번 성공하면 0)로는 멈추지 않고 계속 돈다.
+ * 그래서 성공과 상관없이 1초 안에 NX4_RXERR_LIMIT번을 넘으면 장치를 쓸 수 없는 것으로 보고(surprise removed, drv stopped)
+ * 수신을 다시 걸지 않는다. 장치가 붙어 있으면 인터페이스를 내렸다 올리거나(netdev_open이 표시를 지우고 다시 초기화)
+ * 모듈을 다시 올려 되살린다 */
+#define NX4_RXERR_LIMIT 100
+static int nx4_rx_error_flood(_adapter *padapter)
+{
+	struct dvobj_priv *d = adapter_to_dvobj(padapter);
+	unsigned long now = jiffies;
+
+	if (d->nx4_rxerr_cnt == 0 || time_after(now, d->nx4_rxerr_since + HZ)) {
+		d->nx4_rxerr_since = now;
+		d->nx4_rxerr_cnt = 0;
+	}
+	if (++d->nx4_rxerr_cnt <= NX4_RXERR_LIMIT)
+		return 0;
+	if (!rtw_is_surprise_removed(padapter))
+		printk(KERN_WARNING "nx4-protect: %u rx errors within 1s, rx stopped\n", d->nx4_rxerr_cnt);
+	rtw_set_surprise_removed(padapter);
+	rtw_set_drv_stopped(padapter);
+	return 1;
+}
 
