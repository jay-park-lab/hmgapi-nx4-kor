+/* nx4-protect: 수신이 오류로 끝나면 phl은 그 버퍼를 놀림 목록에 돌려놓기만 하고 다시 걸지 않는다(phl_pend_rxbuf_usb는
+ * 성공·INVALID_PARAM일 때만 _phl_in_token_usb를 부른다). 그래서 보통은 오류마다 걸린 수신 요청(최대 NR_RECV_URB개)이 하나씩
+ * 줄어 수신이 이 기록 없이 멈출 뿐, 오류가 계속 돌지는 않는다. 다만 성공 뒤 다시 걸기에 실패하면 phl의 10ms 지연 타이머
+ * (_phl_rx_deferred_in_token)가 요청을 다시 채우므로, 그때 오류가 몰리는 좁은 경우만 막는다: 성공과 상관없이 1초 안에
+ * NX4_RXERR_LIMIT번을 넘으면 surprise removed·drv stopped로 두어 rtw_usb_read_port가 RTW_CANNOT_RX로 거절하게 한다.
+ * 수신이 멈추면(이 기록 없이 멈춘 경우 포함) 되살리려면 모듈을 다시 올린다(순정 HAL은 Wi-Fi를 끌 때 bcmdhd를 내리므로
+ * Wi-Fi 끄고 켜기, 재부팅, 동글 다시 꽂기. PR #81 리뷰 3) */
+#define NX4_RXERR_LIMIT 100
+static void nx4_rx_error_flood(struct dvobj_priv *d)
+{
+	unsigned long now = jiffies;
 
+	if (d->nx4_rxerr_cnt == 0 || time_after(now, d->nx4_rxerr_since + HZ)) {
+		d->nx4_rxerr_since = now;
+		d->nx4_rxerr_cnt = 0;
+	}
+	if (++d->nx4_rxerr_cnt <= NX4_RXERR_LIMIT)
+		return;
+	if (!dev_is_surprise_removed(d))
+		printk(KERN_WARNING "nx4-protect: %u rx errors within 1s, rx stopped\n", d->nx4_rxerr_cnt);
+	dev_set_surprise_removed(d);
+	dev_set_drv_stopped(d);
+}
