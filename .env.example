# PC에서 쓰는 저장소 밖 경로. 이 파일을 .env.local로 복사해 값을 채웁니다(.env.local은 git에 넣지 않습니다).
#   cp .env.example .env.local
# 한 줄에 KEY=값. 값 앞의 ~/ 는 홈 폴더로 바뀝니다. 명령 앞에 준 값과 셸에 export된 값이 이 파일보다 앞섭니다.
# 읽는 쪽: scripts/local-env.sh
# git worktree에는 이 파일이 없습니다. 메인 체크아웃의 것을 NX4_ENV_FILE=<메인 체크아웃>/.env.local 로 가리킵니다.

# Android SDK (scripts/build-app.sh, tests/emu/)
#   build-tools 37 이상(JDK 21), platforms;android-19, 에뮬레이터 시험이면 platform-tools·emulator도
ANDROID_HOME=

# 상태 화면 앱 서명 키 폴더(release.keystore, pass) (scripts/build-app.sh)
#   폴더에 키가 없으면 build-app.sh가 처음에 만듭니다. 잃으면 차의 앱을 업데이트할 수 없으니 따로 백업합니다.
NX4_APP_KEYS=

# HMG-API 저장소 (scripts/build.sh의 서명 도구, tests/mod-test.sh의 빌드·엔진 시험)
HMGAPI_SRC=

# 모드 작성자 키 파일 (scripts/build.sh)
#   HMG-API는 같은 키로 서명한 업데이트만 받습니다. 따로 백업합니다. 만드는 법은 README.md "만들기와 시험".
NX4_MOD_KEY=

# 선택 (scripts/build.sh)
#   NX4_PKG_ZIP     busybox와 그 라이선스 안내를 꺼낼 Korea Projection 릴리스 패키지 zip
#   HMGAPI_USB_ZIP  같은 USB에 함께 넣을 HMG-API USB 묶음(hmgapi-<버전>-usb.zip)
# NX4_PKG_ZIP=
# HMGAPI_USB_ZIP=
