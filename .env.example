# PC에서 쓰는 저장소 밖 경로. 이 파일을 .env.local로 복사해 값을 채웁니다(.env.local은 git에 넣지 않습니다).
#   cp .env.example .env.local
# 한 줄에 KEY=값. 값 앞의 ~/ 는 홈 폴더로 바뀝니다. 명령 앞에 준 값과 셸에 export된 값이 이 파일보다 앞섭니다.
# 읽는 쪽: scripts/local-env.sh
# git worktree에는 이 파일이 없습니다. 메인 체크아웃의 것을 NX4_ENV_FILE=<메인 체크아웃>/.env.local 로 가리킵니다.

# Android SDK (scripts/build-app.sh, scripts/build-hooks.sh·build.sh의 hooks.jar, tests/emu/, tests/mod-test.sh의 hooks.jar 빌드)
#   build-tools 37 이상(JDK 21), platforms;android-19, 에뮬레이터 시험이면 platform-tools·emulator도
ANDROID_HOME=

# 관리 앱 서명 키 폴더(release.keystore, pass) (scripts/build-app.sh)
#   폴더에 키가 없으면 build-app.sh가 처음에 만듭니다. 잃으면 차의 앱을 업데이트할 수 없으니 따로 백업합니다.
NX4_APP_KEYS=

# HMG-API 저장소 (scripts/build.sh의 서명 도구, scripts/build-hooks.sh가 컴파일에 대는 런타임 소스, tests/mod-test.sh의 빌드·엔진 시험)
HMGAPI_SRC=

# 모드 작성자 키 파일 (scripts/build.sh)
#   HMG-API는 같은 키로 서명한 업데이트만 받습니다. 따로 백업합니다. 만드는 법은 README.md "만들기와 시험".
NX4_MOD_KEY=

# 선택 (scripts/build.sh)
#   NX4_BUSYBOX     함께 넣을 busybox. 비워 두면 mod/bin/busybox(git 제외 파일, 있으면 SHA-256 확인 없이 그대로 씀),
#                   그것도 없으면 Alpine 저장소에서 받아 out/busybox에 둡니다(scripts/fetch-busybox.sh: curl·인터넷 필요,
#                   받은 것만 NOTICE.md의 SHA-256과 비교). 인터넷 없이 만들 때 받아 둔 파일을 가리킵니다(옆에 <파일>-LICENSE.txt)
#   NX4_BUSYBOX_URL busybox 패키지를 받을 미러 주소(https). 비워 두면 Alpine CDN. 같은 파일이어야 합니다(SHA-256 확인)
#   HMGAPI_USB_ZIP  같은 USB에 함께 넣을 HMG-API USB 묶음(hmgapi-<버전>-usb.zip)
#   NX4_WIRELESS_ZIP  USB에 함께 넣을 공식 무선 모드 zip(wireless-carplay-aa-<판>.zip). 비워 두면 공식 릴리스에서 받아
#                   out/wireless에 둡니다(scripts/fetch-wireless.sh: curl·인터넷 필요, 고정한 판, NOTICE.md의 SHA-256과 같을 때만).
#                   인터넷 없이 만들 때 받아 둔 파일을 가리킵니다(SHA-256은 보지 않음)
#   NX4_WIRELESS_URL  공식 무선 모드 zip을 받을 미러 주소(https). 비워 두면 GitHub 릴리스. 같은 파일이어야 합니다(SHA-256 확인)
# NX4_BUSYBOX=
# NX4_BUSYBOX_URL=
# HMGAPI_USB_ZIP=
# NX4_WIRELESS_ZIP=
# NX4_WIRELESS_URL=
