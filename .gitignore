# PC의 저장소 밖 경로(형식은 .env.example)
/.env.local

# 로컬 배포 키 폴더(release.keystore, pass, mod.key, mod.key.pub). 공개하지 않고 저장소 밖에도 백업한다(docs/release.md)
/.keys/
# 다른 곳에 잘못 둔 서명 키도 넣지 않는다
*.keystore
*.key

# 빌드 결과(scripts/build.sh, scripts/build-app.sh)
/out/
/mod/app/
/mod/bin/busybox
/mod/bin/busybox-LICENSE.txt

# Claude Code 작업 공간(세션마다 만드는 git worktree)
/.claude/worktrees/
