{
  "id": "nx4-kor",
  "name": "NX4 KOR: Tucson NX4 (Korea)",
  "version": "2.0.0",
  "hmgapi": ">=1.1.0-rc.8",
  "authors": [
    "parkjoos",
    "StopDragon"
  ],
  "license": "AGPL-3.0",
  "description": "HMG-API add-on for the Korean Tucson NX4 (260902): a status screen for HMG-API and the official Wireless CarPlay + Android Auto mod (wireless-carplay-aa) on this car. Based on Korea Projection (StopDragon).",
  "system": {
    "model": [
      "NX4",
      "NX4HEV"
    ],
    "region": [
      "KOR"
    ],
    "firmware": [
      "260902"
    ]
  },
  "apps": [
    {
      "apk": "app/NX4KOR.apk",
      "package": "io.github.jayparklab.nx4kor"
    }
  ],
  "services": [
    {
      "name": "launch",
      "script": "svc/launch.sh",
      "user": "root",
      "start": "manual",
      "restart": false
    }
  ],
  "provides": {
    "launcher": [
      {
        "package": "io.github.jayparklab.nx4kor",
        "class": ".StatusActivity",
        "icon": "icons/icon.png",
        "icon_night": "icons/icon_night.png",
        "icon_disabled": "icons/icon_disabled.png",
        "icon_disabled_night": "icons/icon_disabled_night.png"
      }
    ]
  }
}
